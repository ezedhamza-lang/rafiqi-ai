# ===== متغيرات البيئة — خادم رفيقي (انسخ إلى backend/.env وعدّل القيم) =====

# قاعدة البيانات (PostgreSQL) — إلزامي
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# سر توقيع JWT — إلزامي. ولّد قيمة عشوائية طويلة:
#   openssl rand -hex 32
JWT_SECRET=""

PORT=3001
NODE_ENV=development

# مصادر الواجهة المسموح بها عبر CORS (في الإنتاج: دومين الواجهة الحقيقي، مفصول بفواصل)
# مثال: https://rafiqi-app.tn,https://www.rafiqi-app.tn
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# الرابط العام للخادم (يُستعمل في روابط الإرجاع بعد الدفع)
PUBLIC_BASE_URL="http://localhost:3001"
APP_URL="http://localhost:5173"

# تحديد المعدل (Rate Limiting)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
BODY_LIMIT=10mb

UPLOAD_DIR=uploads

# ===== الدفع =====
# المزود الافتراضي: DEMO | STRIPE | STB | PAYPAL | PAYMOB | TAP
# تنبيه: DEMO معطّل تلقائياً في الإنتاج إلا إذا عيّنت ALLOW_DEMO_PAYMENTS=true صراحةً.
PAYMENT_PROVIDER=DEMO
ALLOW_DEMO_PAYMENTS=false
PAYMENT_CURRENCY=TND
# مفاتيح Stripe (وضع الاختبار):
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# سر توقيع webhook للمزود التجريبي:
DEMO_WEBHOOK_SECRET=""
# STB:
STB_MERCHANT_ID=""
STB_SECRET=""

# ===== الفيديو المباشر =====
# LOCAL | LIVEKIT
VIDEO_PROVIDER=LOCAL
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
RECORDING_DIR=uploads/recordings

# ===== الذكاء الاصطناعي (اختياري) =====
# يمكن ضبط مفتاح المنصة من فضاء المشرف بدل متغير البيئة.
GEMINI_API_KEY=""

# ===== اختياري =====
# حسابات ترى كل السنوات (تجربة): بريد مفصول بفواصل
EXPLORE_ALL_GRADES_EMAILS="student@test.tn"
# إظهار جواب CAPTCHA (تطوير فقط)
CAPTCHA_REVEAL_ANSWER=false

# ===== Google OAuth (Sign in with Google) =====
GOOGLE_CLIENT_ID="

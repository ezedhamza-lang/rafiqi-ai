# قالب متغيرات البيئة — منصة رفيقي (Backend)
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا تلتزم .env أبداً في Git
# ولا ترفعه ضمن أي أرشيف zip تشاركه خارجياً (راجع القسم 1.2 من تقرير التدقيق).

# ==================== قاعدة البيانات ====================
DATABASE_URL="postgresql://school_user:school_pass@localhost:5432/school_platform?schema=public"

# ==================== الأمان الأساسي ====================
# ولّد قيمة عشوائية طويلة (مثلاً: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
APP_URL="http://localhost:5173"
PUBLIC_BASE_URL="http://localhost:3001"

# ==================== حدود المعدل والحجم ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
BODY_LIMIT=10mb

# ==================== البريد الإلكتروني (nodemailer) ====================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_FROM=
NOTIFICATION_EMAIL_PROVIDER=smtp
NOTIFICATION_SMS_PROVIDER=

# ==================== الذكاء الاصطناعي ====================
GEMINI_API_KEY=
AI_ENC_KEY=

# ==================== الفيديو/الحصص المباشرة (LiveKit) ====================
VIDEO_PROVIDER=livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
RECORDING_ENABLED=false
RECORDING_DIR=uploads/recordings

# ==================== الدفع — عام ====================
PAYMENT_PROVIDER=DEMO
PAYMENT_CURRENCY=TND
CAPTCHA_TTL_MS=600000
CAPTCHA_REVEAL_ANSWER=false
DEMO_WEBHOOK_SECRET=

# ==================== الدفع — تونس (STB) ====================
STB_MERCHANT_ID=
STB_SECRET=

# ==================== الدفع — Stripe (دولي) ====================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ==================== الدفع — PayPal (دولي) ====================
# إصلاح (27-08-2026): هذه المفاتيح مطلوبة فعلياً في الكود
# (services/payments/paypalProvider.js) لكن لم تكن موثقة هنا سابقاً.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
# معرّف الـ Webhook من لوحة تحكم PayPal Developer — إلزامي للتحقق الآمن
# من صحة إشعارات الدفع (بدونه سترفض المنصة كل webhook تلقائياً كإجراء أمان).
PAYPAL_WEBHOOK_ID=

# ==================== الدفع — Paymob (مصر/الخليج) ====================
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_KIOSK_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_VODAFONE_ID=
PAYMOB_ETISALAT_ID=
PAYMOB_ORANGE_ID=
PAYMOB_WE_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_MODE=test
PAYMOB_USE_IFRAME=true

# ==================== الدفع — Tap (الخليج) ====================
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=
TAP_WEBHOOK_SECRET=
TAP_MODE=test
TAP_USE_INVOICE=true

# ==================== الرفع والملفات ====================
UPLOAD_DIR=uploads

# ==================== توثيق API (Swagger) ====================
SWAGGER_USER=
SWAGGER_PASS=

# ==================== مهام دورية ====================
INSIGHT_SWEEP_INTERVAL_MS=3600000
RENEWAL_SWEEP_INTERVAL_MS=3600000

# ==================== اختبارات ====================
MOCK_COUNTRY=TN

{
  "name": "school-platform-backend",
  "version": "1.0.0",
  "description": "منصة الحياة المدرسية - backend",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "seed": "node prisma/seed.js",
    "check:book-access": "node scripts/check-book-access.mjs",
    "check:answer-keys": "node scripts/check-answer-keys.mjs",
    "check:content-images": "node scripts/check-content-images.mjs",
    "check:content-matrix": "node scripts/check-content-matrix.mjs",
    "check:book-pages": "node scripts/check-book-pages.mjs",
    "check:crossyear": "node scripts/check-crossyear-mixing.mjs",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:flows": "node scripts/check-functional-flows.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings=100",
    "check:flows:reverify": "node scripts/check-functional-reverify.mjs",
    "check:negative": "node scripts/check-negative-cases.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.22.0",
    "arabic-reshaper": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "puppeteer-core": "^25.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "prisma": "^5.22.0",
    "supertest": "^7.1.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "yaml": "2.0.0-1"
  }
}
